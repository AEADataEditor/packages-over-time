> # Normalized titles, for matching
> normalize_title <- function(x) {
+   x %>%
+     str_remove_all("<[^>]+>") %>%
+     iconv(to="ASCII//TRANSLIT") %>%
+     tolower() %>%
+     str_replace_all("[^a-z0-9]+"," ") %>%
+     str_squish()
+ }
> 
